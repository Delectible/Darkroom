# Android (CI regenerates missing boilerplate with `flutter create`)
android/.gradle/
android/local.properties
android/**/GeneratedPluginRegistrant.java
android/app/.cxx/
*.apk
*.aab

# iOS
ios/Pods/
ios/.symlinks/
