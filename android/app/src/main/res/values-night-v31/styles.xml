<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash: the rabbit on near-black, the
         launch curtain's own rabbit at the same size and place (splash_rabbit:
         96 dp on the 288 dp splash canvas), so the hand-over doesn't jump. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_rabbit</item>
    </style>
    <!-- The same, for the other icons people can pick (Looks.kt): the
         rabbit with no face, as the app's own launch curtain then shows. -->
    <style name="LaunchTheme.Eyeless" parent="@style/LaunchTheme">
        <item name="android:windowBackground">@drawable/launch_background_eyeless</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_rabbit_eyeless</item>
    </style>
    <!-- The instant icon's own splash (Looks.kt): the icon itself. -->
    <style name="LaunchTheme.Instant" parent="@style/LaunchTheme">
        <item name="android:windowBackground">@drawable/launch_background_instant</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_instant</item>
    </style>
    <!-- The lens icon's own splash (Looks.kt): the icon itself. -->
    <style name="LaunchTheme.Lens" parent="@style/LaunchTheme">
        <item name="android:windowBackground">@drawable/launch_background_lens</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_lens</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
